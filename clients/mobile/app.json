{
  "expo": {
    "name": "Melodia",
    "slug": "melodia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-square.png",
    "scheme": "projetsupcontentmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-square.png",
        "backgroundColor": "#101114"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.biohazardyesorganization.melodia"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      ["expo-splash-screen", {
        "image": "./assets/images/logo.png",
        "imageWidth": 180,
        "resizeMode": "contain",
        "backgroundColor": "#101114"
      }],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a961ba89-48ee-4ea9-b8da-8772ef87999f"
      }
    },
    "owner": "biohazardyes-organization"
  }
}
