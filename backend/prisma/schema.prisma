// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id              String  @id @default(uuid())
  username        String  @unique @db.VarChar(25)
  pseudo          String  @db.VarChar(30)
  email           String  @unique @db.VarChar(320)
  password        String?
  favorite_band   String?
  profile_picture Bytes?
  banner          Bytes?
  shop_points     Int     @default(0)

  owned_cosmetics        String[] @default([])
  equipped_avatar_border String?
  equipped_font          String?
  equipped_title         String?
  equipped_text_effect   String?
  equipped_banner        String?
  equipped_pattern       String?

  role Roles @default(BASIC)

  provider    AuthProvider?
  provider_id String?

  has_notifications Boolean  @default(true)
  phone_number      String?  @db.VarChar(15)
  biography         String?  @db.VarChar(255)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Vérification d'email (comptes LOCAL uniquement — les comptes OAuth sont
  // considérés vérifiés par le fournisseur dès leur création)
  email_verified             Boolean   @default(true)
  email_verification_code    String?
  email_verification_expires DateTime?

  // Réinitialisation de mot de passe
  password_reset_code    String?
  password_reset_expires DateTime?

  // 2FA (TOTP)
  twofa_enabled      Boolean  @default(false)
  twofa_secret       String?
  twofa_backup_codes String[] @default([])

  // Gamification
  earned_badges String[] @default([])

  reviews                 Reviews[]
  review_comments         ReviewComments[]
  review_likes            ReviewLikes[]
  playlists               Playlists[]
  playlist_collaborations PlaylistCollaborators[]
  follows                 Follows[]               @relation("following")
  followers               Follows[]               @relation("followers")
  notifications           Notifications[]         @relation("user_notifications")
  notificationsRelated    Notifications[]         @relation("user_related_notifications")
  user_media_status       UserMediaStatus[]
  reporter_reports        Reports[]               @relation("reporter_reports")
  profile_reports         Reports[]               @relation("profile_reports")

  activities          Activities[]    @relation("user_activities")
  activities_targets  Activities[]    @relation("user_activities_targets")
  conversations_user1 Conversations[] @relation("conversation_user1")
  conversations_user2 Conversations[] @relation("conversation_user2")
  messages            Messages[]
  journal_entries     JournalEntries[]
  commentLikes        CommentLikes[]

  expo_push_token String?

  spotify_account SpotifyAccounts?

  rooms_hosted         Rooms[]            @relation("room_host")
  room_participations  RoomParticipants[]
  room_queue_additions RoomQueueItems[]

  @@unique([provider, provider_id])
}

model JournalEntries {
  id String @id @default(uuid())
  user_id String
  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title String @db.VarChar(200)
  artist String @db.VarChar(200)
  listened_on String @db.VarChar(10)
  mood String @db.VarChar(20)
  rating Int?
  note String @db.VarChar(4000)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, listened_on, created_at])
}

enum AuthProvider {
  LOCAL
  GOOGLE
  DISCORD
  FACEBOOK
}

enum Roles {
  BASIC
  ADMIN
}

model SpotifyAccounts {
  id            String   @id @default(uuid())
  user          Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id       String   @unique
  spotify_id    String
  display_name  String?
  access_token  String
  refresh_token String
  expires_at    DateTime
  product       String? // "premium" | "free" | "open" — from GET /v1/me, gates Listening Rooms access
  scope         String? // space-separated granted OAuth scopes from the token response
  country       String? // ISO 3166-1 alpha-2 from GET /v1/me — used as `market` for catalog search
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Medias {
  id         String   @id @default(uuid())
  api_id     String   @unique
  content    Json
  rating     Float?
  created_at DateTime @default(now())
  expires_at DateTime

  reviews           Reviews[]
  playlist_items    PlaylistItems[]
  user_music_status UserMediaStatus[]
  notifications     Notifications[]
  activities        Activities[]
}

model Reviews {
  id         String   @id @default(uuid())
  user       Users    @relation(fields: [user_id], references: [id])
  user_id    String
  media      Medias   @relation(fields: [media_id], references: [id])
  media_id   String
  rating     Int
  title      String   @db.VarChar(100)
  content    String   @db.VarChar(1000)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  comments ReviewComments[]
  likes    ReviewLikes[]
  reports  Reports[]

  notifications Notifications[]

  activities Activities[]

  @@unique([user_id, media_id])
}

model ReviewComments {
  id         String   @id @default(uuid())
  content    String   @db.VarChar(1000)
  created_at DateTime @default(now())

  review    Reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)
  review_id String

  user    Users  @relation(fields: [user_id], references: [id])
  user_id String

  parent_id String?
  parent    ReviewComments?  @relation("Thread", fields: [parent_id], references: [id], onDelete: Cascade)
  replies   ReviewComments[] @relation("Thread")

  reports      Reports[]
  commentLikes CommentLikes[]
}

model CommentLikes {
  user       Users          @relation(fields: [user_id], references: [id])
  user_id    String
  comment    ReviewComments @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  comment_id String
  created_at DateTime       @default(now())

  @@id([user_id, comment_id])
}

model ReviewLikes {
  user       Users    @relation(fields: [user_id], references: [id])
  user_id    String
  review     Reviews  @relation(fields: [review_id], references: [id], onDelete: Cascade)
  review_id  String
  created_at DateTime @default(now())

  @@id([user_id, review_id])
}

model Playlists {
  id                  String   @id @default(uuid())
  user                Users    @relation(fields: [user_id], references: [id])
  user_id             String
  name                String   @db.VarChar(30)
  image_url           Bytes?
  is_public           Boolean
  is_collaborative    Boolean  @default(false)
  spotify_playlist_id String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  items         PlaylistItems[]
  collaborators PlaylistCollaborators[]

  @@unique([user_id, name])
}

model PlaylistCollaborators {
  playlist    Playlists @relation(fields: [playlist_id], references: [id], onDelete: Cascade)
  playlist_id String
  user        Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     String
  added_at    DateTime  @default(now())

  @@id([playlist_id, user_id])
}

model PlaylistItems {
  id          String    @id @default(uuid())
  playlist    Playlists @relation(fields: [playlist_id], references: [id], onDelete: Cascade)
  playlist_id String
  media       Medias    @relation(fields: [media_id], references: [id])
  media_id    String
  created_at  DateTime  @default(now())

  @@unique([playlist_id, media_id])
}

model UserMediaStatus {
  user       Users       @relation(fields: [user_id], references: [id])
  user_id    String
  media      Medias      @relation(fields: [media_id], references: [id])
  media_id   String
  status     MediaStatus
  created_at DateTime    @default(now())

  @@id([user_id, media_id])
}

enum MediaStatus {
  listened
  later
  favorite
  disliked
  none
}

model Activities {
  id               String          @id @default(uuid())
  user             Users           @relation("user_activities", fields: [user_id], references: [id])
  user_id          String
  target_user      Users?          @relation("user_activities_targets", fields: [target_user_id], references: [id])
  target_user_id   String?
  review           Reviews?        @relation(fields: [review_id], references: [id], onDelete: Cascade)
  review_id        String?
  media            Medias?         @relation(fields: [media_id], references: [id])
  media_id         String?
  rating_from_user Int?
  action           ActivityActions
  created_at       DateTime        @default(now())
}

enum ActivityActions {
  review_created
  rating_added
  playlist_added
  follow
}

model Follows {
  user           Users    @relation("following", fields: [user_id], references: [id])
  user_id        String
  follow_user    Users    @relation("followers", fields: [follow_user_id], references: [id])
  follow_user_id String
  created_at     DateTime @default(now())

  @@id([user_id, follow_user_id])
}

model Reports {
  id          String          @id @default(uuid())
  reporter    Users           @relation("reporter_reports", fields: [reporter_id], references: [id])
  reporter_id String
  review      Reviews?        @relation(fields: [review_id], references: [id], onDelete: Cascade)
  review_id   String?
  profile     Users?          @relation("profile_reports", fields: [profile_id], references: [id])
  profile_id  String?
  comment     ReviewComments? @relation(fields: [comment_id], references: [id])
  comment_id  String?
  reason      String
  reason_type ReportTypes
  is_checked  Boolean         @default(false)
  created_at  DateTime        @default(now())
}

enum ReportTypes {
  comment
  profile
  review
}

model Notifications {
  id              String              @id @default(uuid())
  user            Users               @relation("user_notifications", fields: [user_id], references: [id])
  user_id         String
  action          NotificationActions
  related_user    Users?              @relation("user_related_notifications", fields: [related_user_id], references: [id])
  related_user_id String?
  review          Reviews?            @relation(fields: [review_id], references: [id], onDelete: Cascade)
  review_id       String?
  media           Medias?             @relation(fields: [media_id], references: [id])
  media_id        String?
  is_read         Boolean             @default(false)
  read_at         DateTime?
  created_at      DateTime            @default(now())
}

model BannedUsers {
  id         String   @id @default(uuid())
  user_id    String   @unique
  username   String   @db.VarChar(25)
  email      String   @db.VarChar(320)
  content    String   @db.VarChar(255)
  created_at DateTime @default(now())
}

enum NotificationActions {
  review_added
  new_message
  like_added
  comment_added
  new_follow
  recommendation
  badge_earned
  playlist_collaborator_added
  room_invited
}

enum ConversationStatus {
  ACCEPTED
  PENDING
  DECLINED
}

model Conversations {
  id         String     @id @default(uuid())
  user1      Users      @relation("conversation_user1", fields: [user1_id], references: [id])
  user1_id   String
  user2      Users      @relation("conversation_user2", fields: [user2_id], references: [id])
  user2_id   String
  created_at DateTime   @default(now())
  messages   Messages[]
  // Legacy conversations stay accepted. Following never changes this consent.
  status ConversationStatus @default(ACCEPTED)
  initiated_by String?
  invitation_sent Boolean @default(false)

  @@unique([user1_id, user2_id])
}

model Messages {
  id              String        @id @default(uuid())
  conversation    Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  conversation_id String
  sender          Users         @relation(fields: [sender_id], references: [id])
  sender_id       String
  content         String        @db.VarChar(1000)
  is_read         Boolean       @default(false)
  created_at      DateTime      @default(now())
}

// Listening Rooms — synchronized group Spotify playback (Premium-gated, see spotify.service.ts)
model Rooms {
  id      String @id @default(uuid())
  host    Users  @relation("room_host", fields: [host_id], references: [id])
  host_id String
  name    String @db.VarChar(50)

  is_public Boolean @default(true)
  password  String? // hashé (bcrypt) — requis quand is_public = false, ignoré sinon

  // Playback state anchor — lets late joiners / REST callers compute the live
  // position without asking the host: is_playing ? position_ms + (now - position_updated_at) : position_ms
  current_track_uri     String?
  current_track_name    String?
  current_artist_name   String?
  current_album_art_url String?
  current_duration_ms   Int?
  position_ms           Int      @default(0)
  is_playing            Boolean  @default(false)
  position_updated_at   DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  participants RoomParticipants[]
  queue_items  RoomQueueItems[]
}

model RoomParticipants {
  room      Rooms    @relation(fields: [room_id], references: [id], onDelete: Cascade)
  room_id   String
  user      Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   String
  joined_at DateTime @default(now())

  @@id([room_id, user_id])
}

model RoomQueueItems {
  id            String  @id @default(uuid())
  room          Rooms   @relation(fields: [room_id], references: [id], onDelete: Cascade)
  room_id       String
  added_by      Users   @relation(fields: [added_by_id], references: [id])
  added_by_id   String
  track_uri     String
  track_name    String
  artist_name   String
  album_art_url String?
  duration_ms   Int
  position      Int

  created_at DateTime @default(now())
}
